<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_PlatformName>watchOS</_PlatformName>
    <_PlatformRidNoArch>watchos</_PlatformRidNoArch>
    <Registrar Condition="'$(Registrar)' == ''">trimmable-static</Registrar>
    <DynamicRegistrationSupported Condition="'$(DynamicRegistrationSupported)' == ''">false</DynamicRegistrationSupported>
    <MarshalManagedExceptionMode Condition="'$(MarshalManagedExceptionMode)' == ''">abort</MarshalManagedExceptionMode>
    <_LibMonoLinkMode Condition="'$(_LibMonoLinkMode)' == ''">static</_LibMonoLinkMode>
    <_LibXamarinLinkMode Condition="'$(_LibXamarinLinkMode)' == ''">static</_LibXamarinLinkMode>
    <HotReloadCompatibleBuild Condition="'$(HotReloadCompatibleBuild)' == ''">false</HotReloadCompatibleBuild>
  </PropertyGroup>
  <Import Project="Xamarin.Shared.Sdk.props" Condition="'$(_IsWorkloadEol)' != 'true'" />
  <Import Project="Microsoft.Sdk.Eol.targets" Condition="'$(_IsWorkloadEol)' == 'true'" />
  <PropertyGroup>
    <NetCoreTargetingPackRoot>$([MSBuild]::NormalizeDirectory('$(_XamarinSdkRootDirectory)', '..', '..'))</NetCoreTargetingPackRoot>
    <RuntimeIdentifierGraphPath>$(_XamarinSdkRootDirectory)data/RuntimeIdentifierGraph.json</RuntimeIdentifierGraphPath>
    <DebuggerSupport Condition="'$(DebuggerSupport)' == ''">false</DebuggerSupport>
    <_WatchILCompilerProps>$(NetCoreTargetingPackRoot)Microsoft.DotNet.ILCompiler/$(_XamarinRuntimePackVersion)/build/Microsoft.DotNet.ILCompiler.props</_WatchILCompilerProps>
    <_WatchILLinkProps>$(NetCoreTargetingPackRoot)Microsoft.NET.ILLink.Tasks/$(_XamarinILLinkPackVersion)/build/Microsoft.NET.ILLink.Tasks.props</_WatchILLinkProps>
    <_WatchILCompilerTargets>$(NetCoreTargetingPackRoot)Microsoft.DotNet.ILCompiler/$(_XamarinRuntimePackVersion)/build/Microsoft.DotNet.ILCompiler.SingleEntry.targets</_WatchILCompilerTargets>
    <_WatchILLinkTargets>$(NetCoreTargetingPackRoot)Microsoft.NET.ILLink.Tasks/$(_XamarinILLinkPackVersion)/build/Microsoft.NET.ILLink.targets</_WatchILLinkTargets>
  </PropertyGroup>
  <Import Project="$(_WatchILCompilerProps)" Condition="'$(ILCompilerTargetsPath)' == '' And Exists('$(_WatchILCompilerProps)')" />
  <Import Project="$(_WatchILLinkProps)" Condition="'$(ILLinkTargetsPath)' == '' And Exists('$(_WatchILLinkProps)')" />
</Project>
